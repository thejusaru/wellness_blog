<div style="background-color:#ffe6ea; min-height:80vh; padding:40px; border-radius:10px;">
  <h1 style="text-align:center; color:#333;">Your Activity History 📖</h1>
  <p style="text-align:center; color:#555;">Review all your saved wellness entries below.</p>

  <div id="history-list" style="display:flex; flex-wrap:wrap; justify-content:center; gap:20px; margin-top:30px;">
    <!-- Entries appear here -->
  </div>

  <p id="no-entries" style="text-align:center; margin-top:50px; display:none;">No entries yet. Add one from “Add Wellness”.</p>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const historyContainer = document.getElementById("history-list");
  const noEntriesMsg = document.getElementById("no-entries");

  const entries = JSON.parse(localStorage.getItem("wellnessEntries")) || [];

  if (entries.length === 0) {
    noEntriesMsg.style.display = "block";
  } else {
    noEntriesMsg.style.display = "none";
    historyContainer.innerHTML = entries.reverse().map(entry => `
      <div style="background:white; padding:20px; border-radius:10px; width:320px; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
        <h3 style="color:#ff6699;">${entry.activity}</h3>
        <p><strong>Date:</strong> ${entry.date}</p>
        <p><strong>Time:</strong> ${entry.time} min</p>
        <p><strong>Notes:</strong> ${entry.notes || "No notes"}</p>
      </div>
    `).join('');
  }
});
</script>
