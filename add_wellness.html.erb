<div style="display:flex; justify-content:center; align-items:center; min-height:80vh; background:#ffe6ea;">
  <div style="background:white; padding:40px; border-radius:10px; box-shadow:0 0 10px rgba(0,0,0,0.1); width:350px;">
    <h1 style="text-align:center; color:#333;">Add a New Wellness Entry</h1>
    <p style="text-align:center;">Choose a category and log your activity.</p>

    <%= form_with url: add_wellness_path, method: :post, local: true do %>
      <div style="display:flex; flex-direction:column; gap:15px;">
        <label>Activity:</label>
        <select name="activity" style="padding:8px;">
          <option>Exercise</option>
          <option>Meal Plan</option>
          <option>Mindfulness</option>
          <option>Water Intake</option>
          <option>Sleep</option>
        </select>

        <label>Notes:</label>
        <textarea name="notes" placeholder="Write your notes..." style="padding:8px; height:100px;"></textarea>

        <button type="submit" style="background-color:#ff6699; color:white; border:none; padding:10px; border-radius:6px;">Save Entry</button>
      </div>
    <% end %>
  </div>
</div>
